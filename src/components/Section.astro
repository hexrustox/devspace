---
interface Props {
  id?: string;
  title: string;
  class?: string;
}
const { id, title, class: className } = Astro.props;
---

<section id={id} class:list={["mx-auto max-w-5xl px-6 py-24", className]}>
  <h2 class="font-display text-heading">{title}</h2>
  <div class="mt-10">
    <slot />
  </div>
</section>
