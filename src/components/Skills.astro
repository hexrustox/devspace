---
import { skills } from "../content";
import SkillCard from "./SkillCard";
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-24">
  <h2 class="font-display text-heading">Skills</h2>
  <ul
    class="mt-10 grid list-none grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-3 p-0"
  >
    {
      skills.map((skill) => (
        <li class="transition-opacity duration-300">
          <SkillCard client:visible skill={skill} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  #skills ul:has(li:hover) > li:not(:hover) {
    opacity: 0.5;
  }
</style>
