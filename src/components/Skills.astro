---
import { skills } from "../content";
import SkillCard from "./SkillCard";
import Section from "./Section.astro";
---

<Section id="skills" title="Skills">
  <ul
    class="grid list-none grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-3 p-0"
  >
    {
      skills.map((skill) => (
        <li class="transition-opacity">
          <SkillCard client:visible skill={skill} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  @media (hover: hover) {
    ul:has(li:hover) > li:not(:hover) {
      opacity: 0.5;
    }
  }
</style>
